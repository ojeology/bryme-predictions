{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bryme-predictions",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "predictions.thebryme.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*"
    ]
  }
}
