{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bryme-predictions",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "predictions.thebryme.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "placement": {
    "mode": "smart"
  },
  "browser": {
    "binding": "browser"
  },
  "vars": {
    "ARB_MAX_QUOTE_AGE_SECONDS": "1800",
    "ARB_SNAPSHOT_MAX_AGE_SECONDS": "1800",
    "LSB_MAX_COMPETITIONS": "12"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*"
    ]
  }
}
