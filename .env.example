# Optional normalized JSON feeds for the pre-match arbitrage scanner.
# Leave blank for honest manual/offline mode. Do not commit real credentials.
ARB_FEED_URL=
SPORTYBET_FEED_URL=
NAIRABET_FEED_URL=
BET22_FEED_URL=
BET1X_FEED_URL=
LSCB_FEED_URL=
ARB_MAX_QUOTE_AGE_SECONDS=300

# ---- read a book in a real browser (fallback when a book has no usable JSON) ----
# BROWSER_BOOK_URL=https://...
# BROWSER_BOOK_ROWS={"row":".market-row","event":".event","market":".market","outcome":".sel","odds":".odds"}
# BROWSER_BOOK_COOKIE=session=...
# BROWSER_BOOK_TIMEOUT_MS=20000

# ---- what a market means, when the book does not spell it out ----
# The scanner refuses any quote whose settlement rule is unspecified, because
# "Over 2.5 goals" with overtime and "Over 2.5 goals" in 90 minutes are not
# the same bet. Declare the book's default once.
# BOOK_DEFAULT_RULES=90-minutes
# BOOK_DEFAULT_FAMILY=goals
# SPORTYBET_DEFAULT_RULES=90-minutes
# SPORTYBET_DEFAULT_FAMILY=goals
# BOOK_MIN_STAKE=500
# SPORTYBET_MIN_STAKE=500

# ---- scanner defaults ----
# ARB_TOTAL_STAKE=100000
# ARB_ROUNDING=100
